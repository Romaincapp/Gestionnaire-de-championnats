{
  "name": "gestionnaire-de-championnats",
  "version": "2.0.0",
  "private": true,
  "description": "Application de gestion de championnats (vanilla JS, pas de build).",
  "scripts": {
    "check:duplicates": "node scripts/check-duplicate-functions.js",
    "test": "jest",
    "browser:start": "sh scripts/dev-browser.sh",
    "browser:stop": "sh scripts/dev-browser.sh stop",
    "test:e2e": "node tests/e2e/natation.e2e.js",
    "test:sets": "node tests/e2e/sets.e2e.js",
    "test:pools": "node tests/e2e/pools.e2e.js",
    "test:pools-safety": "node tests/e2e/pools-safety.e2e.js",
    "test:darkmode": "node tests/e2e/darkmode.e2e.js",
    "test:darkmode:mobile": "node tests/e2e/darkmode.e2e.js --mobile",
    "test:a11y": "node tests/e2e/a11y.e2e.js",
    "test:a11y:mobile": "node tests/e2e/a11y.e2e.js --mobile",
    "test:contrast": "node tests/e2e/contrast.e2e.js",
    "test:contrast:mobile": "node tests/e2e/contrast.e2e.js --mobile",
    "test:touch": "node tests/e2e/touch.e2e.js"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "playwright-core": "^1.63.0"
  }
}
